# ============================================================
# Kesta - reglas globales (aplican a todo el repo)
# Las reglas propias de cada parte estan en mobile/ y backend/
# ============================================================

# --- Sistema operativo ---
.DS_Store
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# --- IDEs y editores (configuracion personal) ---
.idea/
*.iml
*.iws
*.ipr
.vscode/*
!.vscode/extensions.json
*.swp
*~

# --- Logs y volcados de la JVM ---
*.log
hs_err_pid*.log
replay_pid*.log

# --- Variables de entorno y secretos ---
.env
.env.*
!.env.example

# --- Archivos temporales de Office (docs/) ---
~$*
*.tmp
