PORT=3000
# El backend SOLO lee DATABASE_URL. Ajusta usuario, contrasena y puerto a tu PostgreSQL local.
# Puerto por defecto de PostgreSQL: 5432 (el de tu instalacion aparece en pgAdmin: SHOW port;).
DATABASE_URL=postgres://postgres:TU_PASSWORD@localhost:5432/kesta_bd
# Base para npm test (hay que crearla antes: kesta_test). Si no se define, se usa localhost:5432.
# TEST_DATABASE_URL=postgres://postgres:TU_PASSWORD@localhost:5432/kesta_test
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
JWT_ACCESS_MINUTOS=15
JWT_REFRESH_DIAS=30
# Reglas de verificacion comunitaria (decision de equipo, ver README)
VERIFICACION_CONFIRMACIONES=2
VERIFICACION_REFUTACIONES=2
# Vigencia de un precio antes de marcarse como desactualizado (dias)
VIGENCIA_DIAS_PROFECO=60
VIGENCIA_DIAS_SCRAPING=7
VIGENCIA_DIAS_COMUNIDAD=14
# Opcional: Firebase Cloud Messaging (ruta al JSON de la cuenta de servicio, o el JSON en una linea)
FCM_SERVICE_ACCOUNT=
# Google Maps Platform, geocodificacion inversa (EXT-01). Clave SOLO de servidor: habilita unicamente "Geocoding API"
# y restringela por IP en Google Cloud. Distinta de la clave del SDK de mapas de la app. Si queda vacia, CAT-07 guarda la direccion en NULL.
GOOGLE_MAPS_API_KEY=
# Tiempo maximo de espera a Google antes de guardar el comercio sin direccion (ms)
GEOCODING_TIMEOUT_MS=3000
# Sincronizacion con el buscador QQP de Profeco (src/etl/qqp-api). Correo del equipo para que Profeco pueda contactarnos.
QQP_CONTACTO=
# Pausa entre busquedas en ms (el servidor limita a 60 peticiones por minuto)
QQP_PAUSA_MS=4000
